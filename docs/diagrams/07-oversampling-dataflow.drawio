<mxfile host="app.diagrams.net">
  <diagram name="过采样数据流" id="dataflow">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="过采样持续学习数据流图" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="10" width="400" height="25" as="geometry"/></mxCell>

        <!-- ===== Left column: Data Sources ===== -->
        <mxCell id="src_title" value="数据源" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="50" width="200" height="20" as="geometry"/></mxCell>

        <mxCell id="src_hc3" value="原领域数据&#xa;HC3-Chinese&#xa;&#xa;10,510 样本&#xa;ChatGPT-3.5 Q&amp;A (2023)&#xa;8 个领域子集" style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="220" height="100" as="geometry"/></mxCell>

        <mxCell id="src_tb" value="目标领域数据&#xa;企业AI安全教材&#xa;&#xa;98 个文本块&#xa;GPT-4/Claude (2026)&#xa;正式学术文体" style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="220" height="100" as="geometry"/></mxCell>

        <!-- ===== Middle column: Transformations ===== -->
        <mxCell id="trans_title" value="数据处理" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="340" y="50" width="200" height="20" as="geometry"/></mxCell>

        <mxCell id="split" value="分层拆分&#xa;8 : 1 : 1&#xa;(train / val / test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="150" height="55" as="geometry"/></mxCell>

        <mxCell id="oversample" value="10x 过采样&#xa;&#xa;82 → 820 (train)&#xa;7 → 70 (val)&#xa;9 → 90 (test)&#xa;&#xa;占比: 0.7% → 7.2%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="150" height="100" as="geometry"/></mxCell>

        <mxCell id="merge" value="合并训练集&#xa;&#xa;HC3: 10,428 (train)&#xa;教材: 820 (train)&#xa;合计: 11,330" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;size=10;" vertex="1" parent="1"><mxGeometry x="340" y="340" width="150" height="70" as="geometry"/></mxCell>

        <!-- ===== Training ===== -->
        <mxCell id="train" value="LoRA 微调&#xa;chinese-roberta-wwm-ext-large&#xa;r=16, α=32, 3 epochs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="180" height="55" as="geometry"/></mxCell>

        <!-- ===== Right column: Dual Validation ===== -->
        <mxCell id="val_title" value="双轨验证" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="200" height="20" as="geometry"/></mxCell>

        <mxCell id="val_tb" value="目标领域验证&#xa;(教材测试集)&#xa;&#xa;召回率: 27.3% → 100%&#xa;p_ai: 0.0096 → 0.9980&#xa;&#xa;✅ 通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="190" height="100" as="geometry"/></mxCell>

        <mxCell id="val_gate" value="回归检查&#xa;原领域退化 &lt; 2%?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="230" width="140" height="60" as="geometry"/></mxCell>

        <mxCell id="val_hc3" value="原领域验证&#xa;(HC3 测试集)&#xa;&#xa;准确率: 95.2% → 95.0%&#xa;退化: 0.2% (&lt; 2%)&#xa;&#xa;✅ 无回归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="190" height="90" as="geometry"/></mxCell>

        <mxCell id="reject" value="❌ 拒绝&#xa;退化过大" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="240" width="100" height="40" as="geometry"/></mxCell>

        <!-- ===== Output ===== -->
        <mxCell id="deploy" value="✅ 部署 v2 模型&#xa;目标领域: 97.7% 准确率&#xa;原领域: 无回归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="450" width="220" height="55" as="geometry"/></mxCell>

        <!-- ===== Edges ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;" edge="1" source="src_hc3" target="split" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;" edge="1" source="src_tb" target="oversample" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="拆分后" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;fontSize=9;" edge="1" source="split" target="merge" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="×10后" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;fontSize=9;" edge="1" source="oversample" target="merge" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;" edge="1" source="merge" target="train" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="train" target="val_tb" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="train" target="val_hc3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="验证" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="val_tb" target="val_gate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="回归" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="val_hc3" target="val_gate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="是" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" source="val_gate" target="deploy" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="否" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeWidth=2;strokeColor=#b85450;" edge="1" source="val_gate" target="reject" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
