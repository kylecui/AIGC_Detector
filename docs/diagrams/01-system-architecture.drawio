        <mxCell id="title" value="中英文AI生成文本检测系统 — 总体架构" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="334" y="20" width="500" height="30" as="geometry"/></mxCell>

        <!-- Layer 1: Clients -->
        <mxCell id="webui" value="Web UI&#xa;(浏览器)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="apiclient" value="API Client&#xa;(curl/SDK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="pdf" value="PDF 文件&#xa;上传" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="140" height="50" as="geometry"/></mxCell>

        <!-- Layer 2: FastAPI Server -->
        <mxCell id="api" value="FastAPI Server (:8000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="540" height="40" as="geometry"/></mxCell>
        <mxCell id="routes" value="Routes&#xa;/detect&#xa;/detect/file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="middleware" value="Middleware&#xa;限流/OOM处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="210" width="100" height="50" as="geometry"/></mxCell>
        <mxCell id="schemas" value="Schemas&#xa;请求/响应" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="210" width="100" height="50" as="geometry"/></mxCell>

        <!-- Layer 3: Detection Pipeline -->
