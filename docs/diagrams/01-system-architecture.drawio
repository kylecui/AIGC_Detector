        <mxCell id="langrouter" value="语言检测&#xa;路由器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="340" width="90" height="50" as="geometry"/></mxCell>
        <mxCell id="s1" value="Stage 1&#xa;统计特征" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="340" width="90" height="50" as="geometry"/></mxCell>
        <mxCell id="s1b" value="Stage 1b&#xa;语言学特征" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="340" width="90" height="50" as="geometry"/></mxCell>
        <mxCell id="s2" value="Stage 2&#xa;编码器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="340" width="90" height="50" as="geometry"/></mxCell>
        <mxCell id="s3" value="Stage 3&#xa;Binoculars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="340" width="90" height="50" as="geometry"/></mxCell>
        <mxCell id="ensemble" value="加权集成&#xa;+阈值判定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="340" width="90" height="50" as="geometry"/></mxCell>

        <!-- Cache arrow -->
        <mxCell id="cachelbl" value="token log-prob&#xa;缓存复用" style="text;html=1;fontSize=9;fontColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="395" width="100" height="30" as="geometry"/></mxCell>

