        <!-- Layer 5: Hardware -->
        <mxCell id="gpu" value="GPU (RTX 3060 12GB)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;size=10;" vertex="1" parent="1"><mxGeometry x="250" y="520" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="disk" value="磁盘缓存&#xa;~60GB 模型" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;size=10;" vertex="1" parent="1"><mxGeometry x="500" y="520" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="hf" value="HuggingFace&#xa;Hub" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="750" y="520" width="140" height="60" as="geometry"/></mxCell>

